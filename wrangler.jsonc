{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The hostname your instance is served from. Add it as a custom domain in
  // the Cloudflare dashboard, then put an Access policy in front of it.
  "routes": [
    {
      "pattern": "artifacts.example.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // Must match the route above: canonical artifact URLs are built from it.
    "PUBLIC_BASE_URL": "https://artifacts.example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artifacts-db",
      // From `wrangler d1 create artifacts-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      // From `wrangler r2 bucket create artifacts-storage`.
      "bucket_name": "artifacts-storage"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
