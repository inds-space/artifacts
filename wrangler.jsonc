{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "artifacts.inds.space",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://artifacts.inds.space"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artifacts-db",
      "database_id": "6bd313a9-5d68-4101-afbb-965b89def980",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "artifacts-storage"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
