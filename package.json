{
  "name": "@inds-space/artifacts",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm run build:worker && pnpm run build:cli",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build:cli": "bun build cli/src/index.ts --compile --outfile dist/artifacts.exe",
    "check": "pnpm run types && tsc --noEmit",
    "cli": "bun run cli/src/index.ts",
    "dev": "wrangler dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "wrangler types --env-interface CloudflareBindings"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
